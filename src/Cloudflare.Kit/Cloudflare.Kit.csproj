<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Cloudflare.Kit</PackageId>
    <Version>0.1.3</Version>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeUpstreamAssemblies</TargetsForTfmSpecificBuildOutput>
    <Description>Cloudflare clients for DNS, KV, D1, R2, Tunnel management and Worker uploads.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bighamx/Cloudflare.Kit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bighamx/Cloudflare.Kit</PackageProjectUrl>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../upstream/Cloudflare.NET/src/Cloudflare.NET/Cloudflare.NET.csproj">
      <PrivateAssets Condition="'$(_IsPacking)' == 'true'">all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="../../upstream/Cloudflare.NET/src/Cloudflare.NET.R2/Cloudflare.NET.R2.csproj">
      <PrivateAssets Condition="'$(_IsPacking)' == 'true'">all</PrivateAssets>
    </ProjectReference>
    <!-- Embedded assemblies still need their external NuGet dependencies at runtime.
         Keep these in sync with both upstream projects when updating the submodule. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="RateLimitHeaders.Polly" Version="1.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.7.1" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.3.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../upstream/Cloudflare.NET/LICENSE.txt" Pack="true" PackagePath="licenses/Cloudflare.NET/" />
    <None Include="../../upstream/Cloudflare.NET/FORK.md" Pack="true" PackagePath="licenses/Cloudflare.NET/" />
  </ItemGroup>
  <Target Name="IncludeUpstreamAssemblies" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Cloudflare.NET.dll;$(OutputPath)Cloudflare.NET.xml;$(OutputPath)Cloudflare.NET.R2.dll;$(OutputPath)Cloudflare.NET.R2.xml" />
    </ItemGroup>
  </Target>
</Project>
